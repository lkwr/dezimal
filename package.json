{
	"name": "dezi",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "A lightweight arbitrary-precision Decimal library",

	"author": "Lukas Heizmann <lukas@heizmann.dev>",
	"license": "MIT",

	"scripts": {
		"build": "tsc --noEmit && node build.ts",
		"test": "vitest",
		"size": "node scripts/bundle-size.ts",
		"bench": "node scripts/bench.ts",
		"check-consumer": "node scripts/check-consumer.ts"
	},

	"repository": {
		"type": "git",
		"url": "git+https://github.com/lkwr/dezi.git"
	},
	"homepage": "https://github.com/lkwr/dezi",
	"bugs": {
		"url": "https://github.com/lkwr/dezi/issues"
	},
	"keywords": [
		"decimal",
		"decimal.js",
		"arbitrary",
		"precision",
		"arithmetic",
		"number",
		"float"
	],

	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^26.6.4",
		"decimal.js": "^10.6.0",
		"rolldown": "^1.2.12",
		"tsdown": "^0.23.0",
		"typescript": "^6.0.3",
		"vitest": "^5.0.3"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.10.0",
			"onFail": "download"
		}
	}
}
