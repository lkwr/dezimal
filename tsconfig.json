{
	"exclude": ["dist"],
	"compilerOptions": {
		"module": "nodenext",
		"target": "esnext",
		"lib": ["esnext"],
		"types": ["node"],
		"noEmit": true,

		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noPropertyAccessFromIndexSignature": true,

		"moduleResolution": "nodenext",
		"allowImportingTsExtensions": true,
		"strict": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"noUncheckedSideEffectImports": true,
		"moduleDetection": "force",
		"skipLibCheck": true,

		"paths": {
			"dezimal": ["./src/index.ts"],
			"dezimal/ops/*": ["./src/ops/*.ts"],
			"dezimal/check/*": ["./src/check/*.ts"],
			"dezimal/format/*": ["./src/format/*.ts"],
			"dezimal/config/*": ["./src/config/*.ts"],
			"dezimal/preset/*": ["./src/preset/*.ts"]
		}
	},
	"include": ["./src/**/*.ts", "./test/**/*.ts", "./scripts/*.ts", "./build.ts"]
}
